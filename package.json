{
  "name": "rms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "web": "next dev --turbopack -p 3000",
    "api": "node server.js",
    "electron:main": "cross-env NODE_ENV=development wait-on tcp:3000 tcp:5000 && electron ./electron/main.js",
    "electron:dev": "concurrently -k -n WEB,API,ELECTRON -c cyan,green,magenta \"npm run web\" \"npm run api\" \"npm run electron:main\"",
    "build": "next build",
    "dist": "npm run build && electron-builder",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "apexcharts": "^4.5.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "next": "^15.2.3",
    "react": "^19.0.0",
    "react-apexcharts": "^1.7.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "15.2.1",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.0.4"
  },
  "description": "This is a [Next.js](https://nextjs.org) project bootstrapped with [`create-next-app`](https://nextjs.org/docs/app/api-reference/cli/create-next-app).",
  "main": "main.js",
  "build": {
    "appId": "com.pharmasynx.app",
    "productName": "PharmaSynx",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "server.js",
      "electron/preload.js",
      "next.config.mjs",
      "public/**/*",
      ".next/**/*",
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}.exe"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
